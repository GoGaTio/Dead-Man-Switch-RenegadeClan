<?xml version="1.0" encoding="utf-8"?>
<Patch>
  
  <Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
    <defName>DMSRC_Gun_DevilRapier</defName>
    <statBases>
      <Mass>17</Mass>
      <Bulk>20</Bulk>
      <SwayFactor>1.1</SwayFactor>
      <ShotSpread>0</ShotSpread>
      <SightsEfficiency>1</SightsEfficiency>
      <RangedWeapon_Cooldown>0.75</RangedWeapon_Cooldown>
    </statBases>
    <Properties>
      <verbClass>CombatExtended.Verb_ShootCEOneUse</verbClass>
      <hasStandardCommand>true</hasStandardCommand>
      <defaultProjectile>DMSRC_Proj_DevilRapier</defaultProjectile>
      <minRange>3.9</minRange>
      <range>39.9</range>
      <warmupTime>2.5</warmupTime>
      <burstShotCount>1</burstShotCount>
      <soundCast>DMS_AC_Shot_GuidedMissile</soundCast>
      <soundCastTail>GunTail_Heavy</soundCastTail>
      <muzzleFlashScale>25</muzzleFlashScale>
      <targetable>true</targetable>
      <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
      <ai_IsWeapon>true</ai_IsWeapon>
      <ai_AvoidFriendlyFireRadius>4</ai_AvoidFriendlyFireRadius>
      <soundAiming>DMS_Ability_LockOn</soundAiming>
      <aimingLineMote>DMSRC_Missile_Aim</aimingLineMote>
      <aimingLineMoteFixedLength>15.9</aimingLineMoteFixedLength>
      <aimingTargetMote>DMSRC_Missile_Target</aimingTargetMote>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetBuildings>true</canTargetBuildings>
        <canTargetPawns>true</canTargetPawns>
      </targetParams>
      <requireLineOfSight>true</requireLineOfSight>
      <beamTargetsGround>true</beamTargetsGround>
      <drawHighlightWithLineOfSight>true</drawHighlightWithLineOfSight>
      <ignorePartialLoSBlocker>true</ignorePartialLoSBlocker>
    </Properties>
    <FireModes>
      <aiAimMode>AimedShot</aiAimMode>
      <noSingleShot>true</noSingleShot>
    </FireModes>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="DMSRC_Proj_DevilRapier"]/projectile</xpath>
    <value>
      <projectile Class="CombatExtended.ProjectilePropertiesCE">
        <damageDef>DMSRC_BombCumulative</damageDef>
        <damageAmountBase>15</damageAmountBase>
        <speed>90</speed>
        <explosionRadius>0.1</explosionRadius>
        <armorPenetrationSharp>600</armorPenetrationSharp>
        <armorPenetrationBlunt>117.3</armorPenetrationBlunt>
      </projectile>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="DMSRC_Proj_DevilRapier"]/thingClass</xpath>
    <value>
      <thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="DMSRC_Proj_DevilRapier"]/comps</xpath>
    <value>
      <comps>
        <li Class="CombatExtended.CompProperties_ProjectileFleck">
          <FleckDatas>
            <li>
              <fleck>Fleck_CERocketFlame</fleck>
              <emissionsPerTick>7</emissionsPerTick>
              <flecksPerEmission>3</flecksPerEmission>
              <scale>1.5</scale>
              <cutoffTickRange>25~60</cutoffTickRange>
              <originOffset>0.4</originOffset>
            </li>
            <li>
              <fleck>Fleck_CERocketSmokeTrail</fleck>
              <emissionsPerTick>1</emissionsPerTick>
              <rotation>0~360</rotation>
              <scale>3</scale>
              <flecksPerEmission>1</flecksPerEmission>
            </li>
            <li>
              <fleck>Fleck_CERocketSmoke</fleck>
              <emissionsPerTick>2</emissionsPerTick>
              <rotation>0~360</rotation>
              <scale>2</scale>
              <flecksPerEmission>1</flecksPerEmission>
              <cutoffTickRange>25~60</cutoffTickRange>
            </li>
          </FleckDatas>
        </li>
      </comps>
    </value>
  </Operation>

</Patch>