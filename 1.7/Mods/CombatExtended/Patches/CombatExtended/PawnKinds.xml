<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <Operation Class="PatchOperationAddModExtension">
    <xpath>
      Defs/PawnKindDef[
      defName="DMSRC_Stormtrooper" or
      defName="DMSRC_RenegadeDragoon" or
      defName="DMSRC_RenegadeDragoon_Explosive"
      ]
    </xpath>
    <value>
      <li Class="CombatExtended.LoadoutPropertiesExtension">
        <primaryMagazineCount>
          <min>8</min>
          <max>14</max>
        </primaryMagazineCount>
        <sidearms>
          <li>
            <generateChance>0.85</generateChance>
            <sidearmMoney>
              <min>200</min>
              <max>1200</max>
            </sidearmMoney>
            <weaponTags>
              <li>CE_Sidearm_Melee</li>
            </weaponTags>
          </li>
        </sidearms>
      </li>
    </value>
  </Operation>

	<Operation Class="PatchOperationAddModExtension">
    <xpath>
      Defs/PawnKindDef[
      defName="DMSRC_Renegade" or
      defName="DMSRC_OfficerCombat" or
      defName="DMSRC_OfficerHigh" or
      defName="DMSRC_Thinker"
      ]
    </xpath>
    <value>
      <li Class="CombatExtended.LoadoutPropertiesExtension">
        <primaryMagazineCount>
          <min>2</min>
          <max>5</max>
        </primaryMagazineCount>
        <sidearms>
          <li>
            <generateChance>0.85</generateChance>
            <sidearmMoney>
              <min>50</min>
              <max>200</max>
            </sidearmMoney>
            <weaponTags>
              <li>CE_Sidearm_Melee</li>
            </weaponTags>
          </li>
        </sidearms>
      </li>
    </value>
	</Operation>

</Patch>