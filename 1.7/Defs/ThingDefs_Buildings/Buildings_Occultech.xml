<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>DMSRC_ProcessComputer_Active</defName>
    <label>Overlord-class computer</label>
    <description>Block of advanced processor arrays. It's impossible to designate what exactly they are processing.</description>
    <thingClass>Fortified.Building_Overseer</thingClass>
    <graphicData>
      <texPath>Things/Building/DMSRC_ProcessComputer</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(4,4)</drawSize>
      <shadowData>
        <volume>(3.8, 3, 2.7)</volume>
      </shadowData>
    </graphicData>
    <size>(3,3)</size>
    <drawerType>MapMeshAndRealTime</drawerType>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <blockWind>true</blockWind>
    <holdsRoof>true</holdsRoof>
    <canOverlapZones>false</canOverlapZones>
    <fillPercent>0.5</fillPercent>
    <rotatable>false</rotatable>
    <receivesSignals>true</receivesSignals>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <disableImpassableShotOverConfigError>true</disableImpassableShotOverConfigError>
    <statBases>
      <MaxHitPoints>1000</MaxHitPoints>
      <Flammability>0</Flammability>
      <WorkToBuild>60000</WorkToBuild>
      <MechBandwidth>52</MechBandwidth>
      <MechControlGroups>4</MechControlGroups>
      <FFF_MechCommandRange>49.9</FFF_MechCommandRange>
    </statBases>
    <constructionSkillPrerequisite>10</constructionSkillPrerequisite>
    <costList>
      <Steel>200</Steel>
      <Tungsteel>100</Tungsteel>
      <ComponentStamped>20</ComponentStamped>
      <ComponentIndustrial>40</ComponentIndustrial>
      <ComponentTransmitter>2</ComponentTransmitter>
      <DMSRC_ProcessorCore>4</DMSRC_ProcessorCore>
    </costList>
    <killedLeavings>
      <ChunkSlagSteel>2</ChunkSlagSteel>
      <Tungsteel>40</Tungsteel>
      <ComponentIndustrial>5</ComponentIndustrial>
      <ComponentSpacer>2</ComponentSpacer>
      <DMSRC_ProcessorCore>1</DMSRC_ProcessorCore>
    </killedLeavings>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <designationCategory>DMS_Category</designationCategory>
    <building>
      <artificialForMeditationPurposes>true</artificialForMeditationPurposes>
      <ai_chillDestination>false</ai_chillDestination>
      <claimable>true</claimable>
      <destroySound>BuildingDestroyed_Metal_Big</destroySound>
      <buildingTags>
        <li>Mechanitor</li>
      </buildingTags>
    </building>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>DMSRC_Overseer</li>
    </researchPrerequisites>
    <comps>
      <li Class="Fortified.CompProperties_Overseer">
        <selectOverseerIconPath>UI/Icons/DMS_SelectGestalt</selectOverseerIconPath>
      </li>
      <li Class="CompProperties_AmbientSound">
        <sound>GeothermalPlant_Ambience</sound>
        <disabledOnUnpowered>true</disabledOnUnpowered>
      </li>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>DMS_Gestalt_CommandArray</li>
          <li>DMS_Gestalt_Transmitter</li>
        </linkableFacilities>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>5000</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
    </comps>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>DMSRC_OccultechExtractor</defName>
    <label>Decoder</label>
    <description>A destructive decoding rig. It fires a high-energy laser through the holographic storage plates inside a stele and analyzes the scattered spectrum to read the data within: the only way for factions outside the colonial fleets to access a stele's contents. Set it flush against a stele and supply power, and it will continuously extract the knowledge and file it into your expeditional research, no researcher required. Extraction stops if the stele runs dry, power is lost, or no stele is in front of it. It can be uninstalled and reinstalled elsewhere.</description>
    <graphicData>
      <texPath>Things/Building/DMSRC_SteleDecoder</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,2)</drawSize>
      <damageData>
        <rect>(0,0,1,1)</rect>
      </damageData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>true</rotatable>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.4</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <pathCost>30</pathCost>
    <tickerType>Rare</tickerType>
    <size>(1,1)</size>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToBuild>4000</WorkToBuild>
      <Mass>60</Mass>
      <Flammability>0.4</Flammability>
    </statBases>
    <costList>
      <Steel>120</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
    <building>
      <destroySound>BuildingDestroyed_Metal_Small</destroySound>
    </building>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <placeWorkers>
      <li>Fortified.PlaceWorker_ShowOccultechExtractorConnection</li>
    </placeWorkers>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>300</basePowerConsumption>
        <idlePowerDraw>50</idlePowerDraw>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="Fortified.CompProperties_OccultechExtractor">
        <knowledgePerDay>30</knowledgePerDay>
        <knowledgeCategory>DMS_Restricted</knowledgeCategory>
        <extractionRect>(0,1,0,1)</extractionRect>
      </li>
    </comps>
  </ThingDef>

</Defs>