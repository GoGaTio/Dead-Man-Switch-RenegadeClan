<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ScenPartDef>
    <defName>DMSRC_Renegades</defName>
    <label>renegades relation</label>
    <category>Fixed</category>
    <scenPartClass>DMSRC.ScenPart_Renegades</scenPartClass>
  </ScenPartDef>

  <GoodwillSituationDef>
    <defName>DMSRC_Renegades</defName>
    <label>ally with renegades</label>
    <workerClass>DMSRC.GoodwillSituationWorker_Renegades</workerClass>
  </GoodwillSituationDef>

  <ScenPartDef>
    <defName>DMSRC_StartingAMO</defName>
    <label>start with AMO</label>
    <scenPartClass>DMSRC.ScenPart_StartingAMO</scenPartClass>
    <category>StartingImportant</category>
    <selectionWeight>0</selectionWeight>
    <summaryPriority>100</summaryPriority>
  </ScenPartDef>

  <ScenarioDef ParentName="ScenarioBase">
    <defName>DMSRC_Scenario</defName>
    <label>Awaiting Renegades</label>
    <description>A group of renegades.</description>
    <scenario>
      <name>Awaiting Renegades</name>
      <summary>A group of renegades.</summary>
      <description>You have been awaiting for decades on this Rimworld till high command gave you an order to begin your activity since local renegades cell is already established.\n\nReinitiate systems of base, activate automatroids, contact renegades clan and begin fighting local Colonial Fleet. Take advantage of technology and you hidden position, use command automatroid to realize sabotage missions on fleet infrastructure.</description>
      <playerFaction>
        <def>PlayerFaction</def>
        <factionDef>DMSRC_PlayerRenegades</factionDef>
      </playerFaction>
      <parts>
        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns_KindDefs">
          <def>ConfigPage_ConfigureStartingPawns</def>
          <summarized>true</summarized>
          <pawnChoiceCount>5</pawnChoiceCount>
          <leftBehindPawnKind>DMSRC_OfficerHigh_Player</leftBehindPawnKind>
          <kindCounts>
            <li>
              <kindDef>DMSRC_OfficerHigh_Player</kindDef>
              <count>1</count>
              <requiredAtStart>true</requiredAtStart>
            </li>
          </kindCounts>
        </li>
        <li Class="Fortified.Structures.ScenPart_AddStartingStructure">
          <def>FFF_AddStartingStructure</def>
          <structureLabel>A destroyed signal tower</structureLabel>
          <nearMapCenter>True</nearMapCenter>
          <chooseFrom>
            <li>DMSRC_ScenarioBase</li>
          </chooseFrom>
        </li>
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>DropPods</method>
        </li>

        <li Class="DMSRC.ScenPart_StartingAMO">
          <def>DMSRC_StartingAMO</def>
          <AMOKind>DMSRC_AMO_DeformedNymph_Secretary</AMOKind>
        </li>
        
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>DMSRC_OccultechExtractor</thingDef>
          <count>1</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>DMS_TacticalPistol</thingDef>
          <count>1</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>DMSRC_Mechlink_Buffed</thingDef>
          <count>1</count>
        </li>

        <li Class="ScenPart_DisableMapGen">
          <def>DisableExostriderRemains</def>
        </li>

        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>DMS_EquipmentAdvanced</project>
        </li>
        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>DMS_EquipmentBasis</project>
        </li>
        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>DMS_Legion</project>
        </li>
        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>DMSRC_NeuroChips</project>
        </li>
        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>DMSRC_FSRMunitions</project>
        </li>
        <li Class="DMSRC.ScenPart_Renegades">
          <def>DMSRC_Renegades</def>
          <enemyWithFleet>true</enemyWithFleet>
          <relations>Ally</relations>
          <goodwill>100</goodwill>
          <startContacted>true</startContacted>
        </li>
      </parts>
    </scenario>
  </ScenarioDef>
</Defs>