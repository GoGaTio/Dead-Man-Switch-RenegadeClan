<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <QuestScriptDef>
    <defName>DMSRC_DefendBroadcastPoint</defName>
    <rootSelectionWeight>0</rootSelectionWeight>
    <expireDaysRange>0.2~0.5</expireDaysRange>
    <everAcceptableInSpace>true</everAcceptableInSpace>
    <isRootSpecial>true</isRootSpecial>
    <questNameRules>
      <rulesStrings>
        <li>questName->[antenna] [need]</li>
        <li>need->In Danger</li>
        <li>need->Under Attack</li>
        <li>need->Needs Defence</li>
        <li>antenna->Signal Tower</li>
        <li>antenna->Radar</li>
        <li>antenna->Broadcaster</li>
        <li>antenna->Antenna</li>
      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->A nearby located broadcast node of [faction_name] is under renegades attack. They need reinforcements as fast as possible and will </li>
      </rulesStrings>
    </questDescriptionRules>
    <root Class="DMSRC.QuestNode_Root_Site">
      <giver>ColonialFleet</giver>
      <sitePart>DMSRC_AntennaPoint</sitePart>
      <oppositeFactionForSite>false</oppositeFactionForSite>
      <timeoutTicks>30000</timeoutTicks>
      <mission>
        <missionClass>DMSRC.QuestPart_Mission_Defend</missionClass>
        <targetDef>DMSRC_LargeBroadcastAntenna</targetDef>
        <wavesCooldown>5000</wavesCooldown>
        <wavesFromOppositeFaction>true</wavesFromOppositeFaction>
      </mission>
    </root>
  </QuestScriptDef>

  <QuestScriptDef>
    <defName>DMSRC_KillRenegadeOfficer</defName>
    <rootSelectionWeight>0.7</rootSelectionWeight>
    <expireDaysRange>5~10</expireDaysRange>
    <everAcceptableInSpace>true</everAcceptableInSpace>
    <rootMinPoints>1000</rootMinPoints>
    <defaultChallengeRating>1</defaultChallengeRating>
    <questNameRules>
      <rulesStrings>
        <li>questName->[destroy] [antenna]</li>
        <li>antenna->Broadcast Tower</li>
        <li>antenna->Broadcast Antenna</li>
        <li>antenna->The Antenna</li>
      </rulesStrings>
      <include>
        <li>DMSRC_QuestTextCommon</li>
      </include>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->[renegadesInfoSource] (*Threat)Colonial fleet(/Threat) broadcast antenna nearby. It creates control area, which allows to perform fleet operations, and therefore should be destroyed.\n\nBroadcast antenna is guarded by group of Colonial fleet (*Threat)automatroids(/Threat) and (*Threat)turrets(/Threat).</li>
      </rulesStrings>
      <include>
        <li>DMSRC_QuestTextCommon</li>
      </include>
    </questDescriptionRules>
    <root Class="DMSRC.QuestNode_Root_Site">
      <giver>ColonialFleet</giver>
      <sitePart>DMSRC_RenegadeOutpost</sitePart>
      <oppositeFactionForSite>true</oppositeFactionForSite>
      <timeoutTicks>300000</timeoutTicks>
      <repValue>10</repValue>
      <rewardValueFactor>1.1</rewardValueFactor>
      <mission>
        <missionClass>DMSRC.QuestPart_Mission_Kill</missionClass>
        <targetKind>DMSRC_OfficerHigh</targetKind>
        <wavesCooldown>60000</wavesCooldown>
        <initialWavesCooldown>60000</initialWavesCooldown>
        <wavesFromOppositeFaction>false</wavesFromOppositeFaction>
      </mission>
    </root>
  </QuestScriptDef>
</Defs>