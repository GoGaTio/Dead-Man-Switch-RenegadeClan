<Defs>

  <ThingDef ParentName="BuildingBase" Name="DMSRC_BaseLiftShaft">
    <defName>DMSRC_LiftShaft_LogisticHub</defName>
    <label>lift shaft</label>
    <description>A large elevator shaft leads to the underground area, large enough to transport vehicles, but apparently there is no way to activate it.</description>
    <rotatable>false</rotatable>
    <defaultPlacingRot>North</defaultPlacingRot>
    <noRightClickDraftAttack>true</noRightClickDraftAttack>
    <thingClass>DMSRC.FacilityEntrance</thingClass>
    <tickerType>Normal</tickerType>
    <category>Building</category>
    <graphicData>
      <texPath>Things/Building/DMS_LiftShaft</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(6,6)</drawSize>
      <shadowData>
        <offset>(1.5,0,0)</offset>
        <volume>(0.65,0.5,0.65)</volume>
      </shadowData>
    </graphicData>
    <size>(5,5)</size>
    <building>
      <isTargetable>false</isTargetable>
      <claimable>false</claimable>
      <repairable>false</repairable>
      <deconstructible>false</deconstructible>
      <neverBuildable>true</neverBuildable>
    </building>
    <portal>
      <pocketMapGenerator>DMSRC_LogisticHub</pocketMapGenerator>
      <exitDef>DMSRC_LiftShaft_Bottom</exitDef>
      <pocketMapSize>150</pocketMapSize>
    </portal>
    <inspectorTabs>
      <li>ITab_ContentsMapPortal</li>
    </inspectorTabs>
    <disableImpassableShotOverConfigError>true</disableImpassableShotOverConfigError>
    <fillPercent>0</fillPercent>
    <useHitPoints>false</useHitPoints>
    <passability>Impassable</passability>
    <holdsRoof>true</holdsRoof>
  </ThingDef>

