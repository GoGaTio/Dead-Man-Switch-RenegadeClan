      <texPath>Things/Building/DMSRC_Hole_7x7Column</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(9,9)</drawSize>
    </graphicData>
    <size>(7,7)</size>
    <tickerType>Normal</tickerType>
    <drawerType>RealtimeOnly</drawerType>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <blockWind>true</blockWind>
    <canOverlapZones>false</canOverlapZones>
    <fillPercent>0.9</fillPercent>
    <rotatable>false</rotatable>
    <receivesSignals>true</receivesSignals>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <holdsRoof>true</holdsRoof>
    <statBases>
      <MaxHitPoints>10000</MaxHitPoints>
      <Flammability>0</Flammability>
      <WorkToBuild>60000</WorkToBuild>
    </statBases>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <building>
      <artificialForMeditationPurposes>true</artificialForMeditationPurposes>
      <ai_chillDestination>false</ai_chillDestination>
      <claimable>false</claimable>
      <destroySound>BuildingDestroyed_Metal_Big</destroySound>
      <buildingTags>
        <li>DMSRC_Quest</li>
      </buildingTags>
    </building>
    <placeWorkers>
      <li>PlaceWorker_NotUnderRoof</li>
      <li>PlaceWorker_InvalidOverSubstructure</li>
    </placeWorkers>
    <comps>
      <li Class="CompProperties_DrawAdditionalGraphics">
        <graphics>
          <li>
            <texPath>Things/Building/DMSRC_Hole_7x7Column_Top</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(9,9)</drawSize>
            <drawOffset>(0, 0.3, 4)</drawOffset>
            <shaderType>Transparent</shaderType>
          </li>
        </graphics>
      </li>
      <li Class="DMSRC.CompProperties_DestroyFacility">
        <onlyWhenAllDestroyed>true</onlyWhenAllDestroyed>
        <ticksToDestroy>300</ticksToDestroy>
        <wreck>DSMRC_StructuralColumn_Destroyed</wreck>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="DSMRC_StructuralColumn">
