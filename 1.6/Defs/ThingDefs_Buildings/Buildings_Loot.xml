<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase" Name="DMSRC_BaseLootBox" Abstract="True">
    <category>Building</category>
    <thingClass>Building</thingClass>
    <pathCost>120</pathCost>
    <passability>PassThroughOnly</passability>
    <thingClass>Fortified.Building_SurplusContainer</thingClass>
    <rotatable>true</rotatable>
    <useHitPoints>true</useHitPoints>
    <destroyable>true</destroyable>
    <statBases>
      <MaxHitPoints>1000</MaxHitPoints>
      <WorkToBuild>1500</WorkToBuild>
    </statBases>
    <building>
      <expandHomeArea>false</expandHomeArea>
      <claimable>true</claimable>
      <repairable>true</repairable>
      <deconstructible>true</deconstructible>
      <neverBuildable>true</neverBuildable>
      <paintable>true</paintable>
    </building>
    <pathCost>45</pathCost>
  </ThingDef>

  <ThingDef ParentName="DMSRC_BaseLootBox">
    <defName>DMSRC_Cargo</defName>
    <label>cargo container</label>
    <description>A standard issue container containing military supplies.</description>
    <rotatable>true</rotatable>
    <tickerType>Normal</tickerType>
    <building>
      <paintable>true</paintable>
    </building>
    <graphicData>
      <color>(0.5,0.5,0.5)</color>
      <texPath>Things/Building/Containers/DMSRC_Cargo</texPath>
      <drawSize>(4.3,6.45)</drawSize>
      <graphicClass>Graphic_Random</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <fillPercent>1</fillPercent>
    <killedLeavingsRanges>
      <ChunkSlagSteel>2~4</ChunkSlagSteel>
    </killedLeavingsRanges>
    <staticSunShadowHeight>0.7</staticSunShadowHeight>
    <size>(2,4)</size>
    <defaultPlacingRot>0</defaultPlacingRot>
    <modExtensions>
      <li Class="Fortified.ModExtension_Lootbox">
        <sound>CrateOpeningStarted</sound>
        <openedGraphicdata>
          <texPath>Things/Building/Containers/DMSRC_Cargo_Open</texPath>
          <drawSize>(4.3,6.45)</drawSize>
          <graphicClass>Graphic_Random</graphicClass>
          <shaderType>CutoutComplex</shaderType>
        </openedGraphicdata>
        <countRange>2~4</countRange>
        <loots>
          <li>DMSRC_PackLoots</li>
        </loots>
        <chanceNotSpawn>0</chanceNotSpawn>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="DMSRC_BaseLootBox">
    <defName>DMSRC_Crate</defName>
    <label>military crate</label>
    <description>A standard issue equipment crate containing military supplies.</description>
    <rotatable>true</rotatable>
    <graphicData>
      <texPath>Things/Building/Containers/DMSRC_Crate</texPath>
      <drawSize>(3,2)</drawSize>
      <graphicClass>Graphic_Random</graphicClass>
      <shaderType>Cutout</shaderType>
    </graphicData>
    <fillPercent>0.4</fillPercent>
    <costList>
      <WoodLog>20</WoodLog>
    </costList>
    <staticSunShadowHeight>0.2</staticSunShadowHeight>
    <size>(2,1)</size>
    <defaultPlacingRot>2</defaultPlacingRot>
    <modExtensions>
      <li Class="Fortified.ModExtension_Lootbox">
        <sound>CrateOpeningStarted</sound>
        <openedGraphicdata>
          <texPath>Things/Building/Containers/DMSRC_Crate_Open</texPath>
          <drawSize>(3,2)</drawSize>
          <graphicClass>Graphic_Random</graphicClass>
          <shaderType>Cutout</shaderType>
        </openedGraphicdata>
        <loots>
          <li>DMSRC_Crate</li>
        </loots>
        <chanceNotSpawn>0</chanceNotSpawn>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="DMSRC_BaseLootBox">
    <defName>DMSRC_PackCrate</defName>
    <label>military parcel</label>
    <description>A standard issue parcel containing supplies for military logistics.</description>
    <rotatable>false</rotatable>
    <graphicData>
      <texPath>Things/Building/Containers/DMSRC_PackCrate</texPath>
      <drawSize>(3,3)</drawSize>
      <graphicClass>Graphic_Random</graphicClass>
      <shadowData>
        <offset>(0,0,0)</offset>
        <volume>(2,0.8,2)</volume>
      </shadowData>
    </graphicData>
    <fillPercent>0.5</fillPercent>
    <costList>
      <Cloth>40</Cloth>
    </costList>
    <size>(2,2)</size>
    <defaultPlacingRot>0</defaultPlacingRot>
    <modExtensions>
      <li Class="Fortified.ModExtension_Lootbox">
        <sound>CrateOpeningStarted</sound>
        <openedGraphicdata>
          <texPath>Things/Building/Containers/DMSRC_PackCrate_Open</texPath>
          <drawSize>(3,3)</drawSize>
          <graphicClass>Graphic_Random</graphicClass>
          <shadowData>
            <volume>(2,0.25,2)</volume>
          </shadowData>
        </openedGraphicdata>
        <loots>
          <li>DMSRC_PackLoots</li>
        </loots>
        <chanceNotSpawn>0</chanceNotSpawn>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="DMSRC_BaseLootBox">
    <defName>DMSRC_Drawer</defName>
    <label>drawer</label>
    <description>A standard drawer which usually contains some valueable small items.</description>
    <rotatable>true</rotatable>
    <graphicData>
      <texPath>Things/Building/Containers/DMSRC_Drawer/DMSRC_Drawer</texPath>
      <drawSize>(2,2)</drawSize>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <fillPercent>0.5</fillPercent>
    <costList>
      <Steel>30</Steel>
    </costList>
    <size>(1,1)</size>
    <defaultPlacingRot>0</defaultPlacingRot>
    <modExtensions>
      <li Class="Fortified.ModExtension_Lootbox">
        <sound>CrateOpeningStarted</sound>
        <openedGraphicdata>
          <texPath>Things/Building/Containers/DMSRC_Drawer/DMSRC_DrawerOpen</texPath>
          <drawSize>(2,2)</drawSize>
          <graphicClass>Graphic_Multi</graphicClass>
          <shaderType>CutoutComplex</shaderType>
        </openedGraphicdata>
        <countRange>1</countRange>
        <chanceNotSpawn>0</chanceNotSpawn>
        <loots>
          <li>DMSRC_Drawer</li>
        </loots>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef Abstract="True" Name="DMSRC_ContainerBase" ParentName="BuildingBase">
    <label>security container</label>
    <description>A hermetically-sealed armored container for preserving valuable items. Special security system will destroy any contents if container is destroyed or deconstucted.</description>
    <thingClass>DMSRC.Building_SecurityContainer</thingClass>
    <graphicData>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(5, 5)</drawSize>
      <drawOffset>(0, 0, 0)</drawOffset>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <size>(3,3)</size>
    <pathCost>65</pathCost>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-2)</interactionCellOffset>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>0.6</fillPercent>
    <tickerType>Normal</tickerType>
    <drawerType>MapMeshAndRealTime</drawerType>
    <canOverlapZones>false</canOverlapZones>
    <building>
      <ai_chillDestination>true</ai_chillDestination>
      <paintable>false</paintable>
    </building>
    <statBases>
      <WorkToBuild>75000</WorkToBuild>
      <MaxHitPoints>1500</MaxHitPoints>
      <Flammability>0</Flammability>
      <Beauty>0</Beauty>
    </statBases>
    <inspectorTabs>
      <li>DMSRC.ITab_ContentsSecurityContainer</li>
    </inspectorTabs>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <blockWind>true</blockWind>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <staticSunShadowHeight>0.4</staticSunShadowHeight>
    <drawHighlight>true</drawHighlight>
    <preventGravshipLandingOn>true</preventGravshipLandingOn>
  </ThingDef>

  <ThingDef Abstract="True" ParentName="DMSRC_ContainerBase" Name="DMSRC_NaraContainerBase">
    <label>security container</label>
    <placeWorkers>
      <li>PlaceWorker_InvalidOverSubstructure</li>
    </placeWorkers>
    <comps>
      <li Class="CompProperties_Hackable">
        <defence>600</defence>
        <effectHacking>HackingTerminal</effectHacking>
        <lockoutDurationHoursRange>2~4</lockoutDurationHoursRange>
        <notHackedInspectString>Hack to open.</notHackedInspectString>
        <hackedInspectString>Opened.</hackedInspectString>
        <showProgressAfterHackCompletion>false</showProgressAfterHackCompletion>
        <hackedMessage>{HACKER_labelShort} has finished hacking {SUBJECT_labelNoParenthesisDef}.</hackedMessage>
        <intellectualSkillPrerequisite>4</intellectualSkillPrerequisite>
      </li>
      <li Class="DMSRC.CompProperties_SecurityContainer">
        <defaultLoot>DMSRC_SecurityContainer_Nara</defaultLoot>
        <faction>DMSRC_RenegadeClan</faction>
        <graphicData>
          <texPath>Things/Building/Containers/DMSRC_SecurityContainer/DMSRC_ContainerOpen</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>(5, 5)</drawSize>
        </graphicData>
        <defenceFactorRange>20~40</defenceFactorRange>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="DMSRC_NaraContainerBase">
    <defName>DMSRC_SecurityContainer_NaraRed</defName>
    <graphicData>
      <texPath>Things/Building/Containers/DMSRC_SecurityContainer/DMSRC_ContainerNaraRed</texPath>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="DMSRC_NaraContainerBase">
    <defName>DMSRC_SecurityContainer_NaraBlue</defName>
    <graphicData>
      <texPath>Things/Building/Containers/DMSRC_SecurityContainer/DMSRC_ContainerNaraBlue</texPath>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="DMSRC_NaraContainerBase">
    <defName>DMSRC_SecurityContainer_NaraGreen</defName>
    <graphicData>
      <texPath>Things/Building/Containers/DMSRC_SecurityContainer/DMSRC_ContainerNaraGreen</texPath>
    </graphicData>
  </ThingDef>

</Defs>