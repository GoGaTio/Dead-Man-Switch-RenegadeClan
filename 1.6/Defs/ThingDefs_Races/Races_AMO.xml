  <HediffDef>
    <defName>DMSRC_AMO</defName>
    <label>System Maintenance</label>
    <hediffClass>HediffWithComps</hediffClass>
    <description>.</description>
    <isBad>false</isBad>
    <comps>
      <li Class="Fortified.HediffCompProperties_MechHeal">
        <healAmount>1</healAmount>
        <healIntervalTicksStanding>600</healIntervalTicksStanding>
      </li>
    </comps>
    <stages>
      <li>
        <becomeVisible>false</becomeVisible>
        <disablesNeeds>
          <li>MechEnergy</li>
        </disablesNeeds>
      </li>
    </stages>
  </HediffDef>
    
  <ThingDef ParentName="BaseAutomatroidHumanRace">
    <defName>DMSRC_AMO_DeformedNymph</defName>
    <label>deformed nymph</label>
    <description>An artificial semi-organic life form created by restored █████████ technology. This creature is not fully gestated, it's internal parts are sticking out in some places, it's skin and hair are morbid grey, sometimes it will malfunction.\n\nCOLONIAL FLEET NOTE: This is not actual █████, it is unauthorized military organism, it MUST be destroyed and it remains MUST be annihilated. Do not let it close at any cost.</description>
    <thingClass>DMSRC.DeformedNymph</thingClass>
    <uiIconPath>Things/Automatroid/AMO/DMSRC_DeformedNymph_Icon</uiIconPath>
    <hiddenWhileUndiscovered>true</hiddenWhileUndiscovered>
    <statBases>
      <FoodPoisonChance>0</FoodPoisonChance>
      <MarketValue>3000</MarketValue>
      <MoveSpeed>5.5</MoveSpeed>
      <ArmorRating_Blunt>0.4</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.4</ArmorRating_Sharp>
      <EMPResistance>1</EMPResistance>
      <BandwidthCost>0</BandwidthCost>
      <ControlTakingTime>0</ControlTakingTime>
      <IncomingDamageFactor>0.5</IncomingDamageFactor>
    </statBases>
    <inspectorTabs Inherit="False">
      <li>ITab_Pawn_Health</li>
      <li>ITab_Pawn_Needs</li>
      <li>ITab_Pawn_FormingCaravan</li>
      <li>ITab_Pawn_Gear</li>
      <li>ITab_Pawn_Log</li>
    </inspectorTabs>
    <tools Inherit="false">
      <li>
        <label>left fist</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>10</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>14</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>right fist</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>10</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>14</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>teeth</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>15</power>
        <cooldownTime>0.5</cooldownTime>
        <armorPenetration>1</armorPenetration>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        <chanceFactor>5</chanceFactor>
        <soundMeleeHit>Pawn_Melee_HumanBite_Hit</soundMeleeHit>
        <soundMeleeMiss>Pawn_Melee_HumanBite_Miss</soundMeleeMiss>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>5</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <race>
      <specialShadowData Inherit="False">
        <volume>(0.3, 0.8, 0.4)</volume>
        <offset>(0,0,-0.3)</offset>
      </specialShadowData>
      <mechWeightClass IsNull="True"/>
      <renderTree>HumanlikeMech</renderTree>
      <thinkTreeMain>DMS_HumanlikeMech</thinkTreeMain>
      <makesFootprints>true</makesFootprints>
      <body>DMS_Synthroid</body>
      <nameGenerator>DMSRC_DeformedNymphName</nameGenerator>
      <mechFixedSkillLevel>10</mechFixedSkillLevel>
      <mechEnabledWorkTypes>
        <li>Cleaning</li>
        <li>Firefighter</li>
        <li>Cooking</li>
        <li>Tailoring</li>
        <li>Doctor</li>
        <li>Handling</li>
        <li MayRequire="gondragon.mechanoidwaiter">Gastronomy_Waiting</li>
        <li MayRequire="orion.hospitality">Diplomat</li>
        <li MayRequire="frozensnowfox.complexjobs">FSFRearming</li>
        <li MayRequire="frozensnowfox.complexjobs">FSFCremating</li>
        <li MayRequire="frozensnowfox.complexjobs">FSFDeliver</li>
      </mechEnabledWorkTypes>
      <lifeStageAges Inherit="False">
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_Mech_Legionary_Wounded</soundWounded>
          <soundDeath>Pawn_Mech_Legionary_Death</soundDeath>
          <soundCall>Pawn_Mech_Legionary_Call</soundCall>
        </li>
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>100</minAge>
          <soundWounded>Pawn_Mech_Legionary_Wounded</soundWounded>
          <soundDeath>Pawn_Mech_Legionary_Death</soundDeath>
          <soundCall>Pawn_Mech_Legionary_Call</soundCall>
        </li>
      </lifeStageAges>
    </race>
    <comps Inherit="False">
      <li Class="CompProperties_CanBeDormant">
        <compClass>CompMechanoid</compClass>
      </li>
      <li Class="CompProperties_WakeUpDormant">
        <wakeUpOnDamage>true</wakeUpOnDamage>
        <wakeUpCheckRadius>30</wakeUpCheckRadius>
        <wakeUpSound>MechanoidsWakeUp</wakeUpSound>
      </li>
      <li Class="CompProperties_OverseerSubject">
        <delayUntilFeralCheck>9999999</delayUntilFeralCheck>
        <feralMtbDays>9999999</feralMtbDays>
      </li>
      <li Class="Fortified.CompProperties_MechApparel">
      </li>
    </comps>
    <modExtensions>
      <li Class="Fortified.TurretMannableExtension"/>
      <li Class="Fortified.HumanlikeMechExtension">
        <bodyTypeOverride>Female</bodyTypeOverride>
        <headTypeOverride>Female_AverageNormal</headTypeOverride>
        <headGraphic>
          <texPath>Things/Automatroid/AMO/DMSRC_DeformedNymph_Head</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.5</drawSize>
        </headGraphic>
        <canChangeHairStyle>true</canChangeHairStyle>
        <headGraphicHaired>
          <texPath>Things/Automatroid/AMO/DMSRC_DeformedNymph_Head</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.5</drawSize>
        </headGraphicHaired>
        <headOffset>(0,0,-0.05)</headOffset>
      </li>
      <li Class="Fortified.MechWeaponExtension">
        <EnableWeaponFilter>false</EnableWeaponFilter>
        <EnableTechLevelFilter>false</EnableTechLevelFilter>
      </li>
    </modExtensions>
  </ThingDef>

  <PawnKindDef Name="DMSRC_DeformedNymphKind" ParentName="BaseAutomatroidKind">
